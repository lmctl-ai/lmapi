{
  "cases": [
    {
      "name": "tool named constructor is rejected as RESERVED_NAME",
      "document": {
        "schema": "cli.schema.v1",
        "tool": "constructor",
        "policy": { "dryrun": true, "readonly": true },
        "inputs": ["flags"],
        "operations": []
      },
      "expect": {
        "ok": false,
        "issues": [{ "code": "RESERVED_NAME" }]
      }
    },
    {
      "name": "operation named constructor is rejected as RESERVED_NAME",
      "document": {
        "schema": "cli.schema.v1",
        "tool": "mytool",
        "policy": { "dryrun": true, "readonly": true },
        "inputs": ["flags"],
        "operations": [
          { "name": "constructor", "params": [] }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [{ "code": "RESERVED_NAME" }]
      }
    },
    {
      "name": "param named prototype is rejected as RESERVED_NAME",
      "document": {
        "schema": "cli.schema.v1",
        "tool": "mytool",
        "policy": { "dryrun": true, "readonly": true },
        "inputs": ["flags"],
        "operations": [
          {
            "name": "myop",
            "params": [{ "name": "prototype", "type": "string" }]
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [{ "code": "RESERVED_NAME", "param": "prototype" }]
      }
    },
    {
      "name": "param alias named __proto__ is rejected as RESERVED_NAME",
      "document": {
        "schema": "cli.schema.v1",
        "tool": "mytool",
        "policy": { "dryrun": true, "readonly": true },
        "inputs": ["flags"],
        "operations": [
          {
            "name": "myop",
            "params": [{ "name": "validParam", "type": "string", "aliases": ["__proto__"] }]
          }
        ]
      },
      "expect": {
        "ok": false,
        "issues": [{ "code": "RESERVED_NAME", "param": "validParam" }]
      }
    },
    {
      "name": "global param named constructor is rejected as RESERVED_NAME",
      "document": {
        "schema": "cli.schema.v1",
        "tool": "mytool",
        "policy": { "dryrun": true, "readonly": true },
        "inputs": ["flags"],
        "globals": [{ "name": "constructor", "type": "string" }],
        "operations": []
      },
      "expect": {
        "ok": false,
        "issues": [{ "code": "RESERVED_NAME", "param": "constructor" }]
      }
    },
