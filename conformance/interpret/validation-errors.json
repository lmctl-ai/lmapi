{
  "cases": [
    {
      "name": "unknown tool with typo suggestion",
      "schemas": "fixtures/git2.cli.schema.v1.json",
      "line": "gti2 lm_status",
      "expect": {
        "ok": false,
        "issues": [
          { "code": "UNKNOWN_TOOL", "suggestion": "git2" }
        ]
      }
    },
    {
      "name": "unknown tool without suggestion",
      "schemas": "fixtures/git2.cli.schema.v1.json",
      "line": "completely_unknown_tool lm_status",
      "expect": {
        "ok": false,
        "issues": [
          { "code": "UNKNOWN_TOOL" }
        ]
      }
    },
    {
      "name": "missing operation after tool",
      "schemas": "fixtures/git2.cli.schema.v1.json",
      "line": "git2",
      "expect": {
        "ok": false,
        "issues": [
          { "code": "UNKNOWN_OPERATION" }
        ]
      }
    },
    {
      "name": "flag before operation long form",
      "schemas": "fixtures/git2.cli.schema.v1.json",
      "line": "git2 --schema",
      "expect": {
        "ok": false,
        "issues": [
          { "code": "FLAG_BEFORE_OP" }
        ]
      }
    },
    {
      "name": "flag before operation short form",
      "schemas": "fixtures/git2.cli.schema.v1.json",
      "line": "git2 -h",
      "expect": {
        "ok": false,
        "issues": [
          { "code": "FLAG_BEFORE_OP" }
        ]
      }
    },
    {
      "name": "unknown operation with typo suggestion",
      "schemas": "fixtures/git2.cli.schema.v1.json",
      "line": "git2 lm_statux",
      "expect": {
        "ok": false,
        "issues": [
          { "code": "UNKNOWN_OPERATION", "suggestion": "lm_status" }
        ]
      }
    }
  ]
}
